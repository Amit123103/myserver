# Server Network Configuration
NODE_ENV=production
HTTP_PORT=80
HTTPS_PORT=443
FALLBACK_HTTP_PORT=8080
FALLBACK_HTTPS_PORT=8443
HOST=0.0.0.0
DOMAIN=myserver.local

# Security & CORS
ALLOWED_ORIGINS=https://myserver.local,https://localhost,https://127.0.0.1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_BODY_SIZE_BYTES=1048576
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars_long

# Paths & Storage
DATA_DIR=./data
BACKUP_DIR=./backups
LOG_DIR=./logs
CERTS_DIR=./certs
BACKUP_RETENTION_DAYS=7

# DNS Server
DNS_ENABLED=true
DNS_PORT=53
DNS_HOST=0.0.0.0

# ACME / Let's Encrypt (Set to true when exposing a public domain)
ACME_ENABLED=false
ACME_EMAIL=admin@example.com
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
